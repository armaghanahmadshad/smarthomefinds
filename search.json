---
layout: null
sitemap: false
---
[
{% for g in site.guides %}{% assign cat = site.data.categories | where: "id", g.category | first %}
{"type":"Guide","title":{{ g.card_title | default: g.title | jsonify }},"category":{{ cat.name | jsonify }},"url":{{ site.baseurl | append: g.url | jsonify }},"summary":{{ g.card_summary | default: g.description | jsonify }},"text":{{ g.content | strip_html | normalize_whitespace | truncatewords: 500 | jsonify }}},
{% endfor %}
{% for p in site.data.products %}
{"type":"Product","title":{{ p.name | jsonify }},"category":{{ p.category | jsonify }},"url":{{ site.baseurl | append: "/products/#" | append: p.id | jsonify }},"summary":{{ p.description | jsonify }},"text":{{ p.description | jsonify }}}{% unless forloop.last %},{% endunless %}
{% endfor %}
]
