---
layout: null
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% for p in site.pages %}{% unless p.sitemap == false or p.noindex %}
  <url><loc>{{ site.url }}{{ site.baseurl }}{{ p.url }}</loc><lastmod>{{ site.time | date: "%Y-%m-%d" }}</lastmod></url>
{% endunless %}{% endfor %}
{% for g in site.guides %}
  <url><loc>{{ site.url }}{{ site.baseurl }}{{ g.url }}</loc><lastmod>{{ site.time | date: "%Y-%m-%d" }}</lastmod></url>
{% endfor %}
</urlset>
